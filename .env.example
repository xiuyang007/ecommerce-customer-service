# Application
APP_NAME=ecommerce-customer-service
APP_ENV=dev

# OpenAI-compatible upstream. Keep the key local; never commit .env.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
LLM_STRUCTURED_METHOD=json_mode

# MySQL (docker compose maps container 3306 to host 13306)
DATABASE_URL=mysql+asyncmy://app:app_password@127.0.0.1:13306/ecommerce_support?charset=utf8mb4
DATABASE_ECHO=false
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=app
MYSQL_PASSWORD=app_password
MYSQL_PORT=13306
TOOL_MAX_STEPS=3

# Chapter 04: Milvus and retrieval models
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=knowledge_chunks
EMBEDDING_MODEL=D:/models/huggingface/bge-m3
EMBEDDING_DEVICE=cpu
RERANKER_MODEL=D:/models/huggingface/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RAG_DENSE_TOP_K=50
RAG_BM25_TOP_K=50
RAG_RRF_K=60
RAG_FINAL_TOP_K=10
RAG_MIN_RERANK_SCORE=0.1
HF_HOME=D:/models/huggingface

# Conversation limits
CONTEXT_WINDOW_TOKENS=8192
OUTPUT_RESERVED_TOKENS=800
CONTEXT_SAFETY_TOKENS=256
MAX_MESSAGE_CHARS=8000
SESSION_TTL_SECONDS=3600
MAX_SESSION_COUNT=1000
