# Application
APP_NAME=ecommerce-customer-service
APP_ENV=dev

# OpenAI-compatible upstream. Keep the key local; never commit .env.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
LLM_STRUCTURED_METHOD=function_calling

# Conversation limits
CONTEXT_WINDOW_TOKENS=8192
OUTPUT_RESERVED_TOKENS=800
CONTEXT_SAFETY_TOKENS=256
MAX_MESSAGE_CHARS=8000
SESSION_TTL_SECONDS=3600
MAX_SESSION_COUNT=1000
